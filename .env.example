TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_CHAT_ID=your_chat_id_here

# Whale detection thresholds
MIN_TRADE_SIZE_USD=100000
MIN_POSITION_SIZE_USD=500000
MIN_LIQUIDATION_SIZE_USD=200000
MIN_PNL_ALERT_USD=50000

# Settings
DB_PATH=whale_bot.db
LOG_LEVEL=INFO
ALERT_COOLDOWN_SECONDS=300

# Signal bot (kèo)
SIGNAL_CHANNEL_ID=          # ID channel Telegram để post kèo (vd: -1001234567890)
AUTO_SIGNAL_ENABLED=false   # Tự động tạo kèo từ whale trade lớn
AUTO_SIGNAL_SL_PCT=3        # SL cách entry bao nhiêu % (mặc định 3%)
AUTO_SIGNAL_RR=2            # Risk:Reward ratio (TP3 = SL * RR)
AUTO_SIGNAL_MIN_USD=500000  # Kích thước tối thiểu để tạo auto-signal ($)

# Binance Futures WebSocket
BINANCE_ENABLED=true
BINANCE_SYMBOLS=BTC,ETH,SOL,BNB,DOGE,AVAX

# Bybit Futures WebSocket
BYBIT_ENABLED=true
BYBIT_SYMBOLS=BTC,ETH,SOL

# Coinglass REST (optional)
COINGLASS_API_KEY=           # Để trống nếu không có — tự động dùng Binance REST thay thế
COINGLASS_POLL_INTERVAL=300  # giây

# OI Spike Detector
OI_SPIKE_THRESHOLD=5.0       # % thay đổi OI để trigger alert
OI_POLL_INTERVAL=300         # giây

# Funding Rate Detector
FUNDING_EXTREME_HIGH=0.10    # % funding quá cao (over-leveraged long)
FUNDING_EXTREME_LOW=-0.05    # % funding quá thấp (over-leveraged short)
FUNDING_POLL_INTERVAL=3600   # giây (mỗi giờ)

# Confluence Scorer
CONFLUENCE_ENABLED=true
CONFLUENCE_WINDOW=300        # giây — cửa sổ tổng hợp signal
CONFLUENCE_MIN_SOURCES=3     # số nguồn tối thiểu để emit alert
